# =============================================================================
# MoneyAPP — .env ESPECÍFICO. Infra comum em ../shared.env.
# DATABASE_URL é montado pelo docker-compose como ${DB_DSN}/${DB_NAME}.
# Subir:  docker compose --env-file ../shared.env --env-file .env up -d --build
# =============================================================================

CORS_ORIGIN='https://money.astralwavelabel.com,https://todo.astralwavelabel.com,http://localhost:5173,http://localhost'

# Nome do banco no server_db_postgres (compose monta DATABASE_URL com o DB_DSN).
DB_NAME='moneyapp'

# Uploads e arquivos
MAX_RECEIPT_BYTES=5242880

# ── Frontend (Vite — BUILD TIME) ────────────────────────────────────────────
VITE_LOGINHUB_APP_ID='3'
# O docker-compose injeta esta var como build arg do frontend. Ela estava
# ausente, então o bundle era compilado com a URL vazia e o login pelo
# LoginHub caía no fallback do SPA em vez de chegar na API.
VITE_LOGINHUB_API_URL='https://loginhub.astralwavelabel.com/api'

# ── Bot do Telegram ─────────────────────────────────────────────────────────
# Estas vars eram um .env separado em apps/bot/MoneyAPP_BOT/.env. Unificado aqui
# para o MoneyAPP ter UM só .env, como os outros apps do suite. Só o bot lê
# (config.ts); o backend valida env com z.object() sem .strict(), então chave
# extra é descartada em silêncio — não afeta backend nem frontend.
# BACKEND_URL NÃO entra aqui: o docker-compose já define em `environment:`, que
# tem precedência sobre env_file. Duplicar só criaria um valor morto e enganoso.
TELEGRAM_BOT_TOKEN=

# URL INTERNA (rede docker) — diferente da pública usada pelo Vite acima.
LOGINHUB_API_URL='http://server_loginhub_backend:3000/api'
LOGINHUB_APP_ID=3

# ── IA — comprovantes / voz (Ollama) ────────────────────────────────────────
# OLLAMA_URL vem do ../shared.env.
#
# Modelo de VISÃO (OCR de comprovantes). CUIDADO: aqui OLLAMA_MODEL é o de
# visão — no MailAPP a MESMA variável é o modelo de texto. Não mover p/ o shared.
# MANTIDO após aferição em 07/2026 com cupom fiscal sintético: acertou valor,
# tipo, data, categoria e estabelecimento em 3/3 repetições.
# NÃO trocar por qwen3-vl:8b: com `format: 'json'` (que scanReceipt.ts usa) o
# Ollama joga a resposta toda no campo `thinking` e devolve `response` VAZIO —
# o scanReceipt lê `data.response` e quebraria. `think: false` não corrige.
OLLAMA_MODEL='qwen2.5vl:7b'

# Modelo de TEXTO (transação por voz). Tag fixa p/ casar com o OLLAMA_TEXT_MODEL
# do shared e não virar um 2º modelo residente: em 12GB só um fica na VRAM.
# Desde 07/2026 é o MESMO tag do OLLAMA_MODEL acima (visão), então voz e
# comprovante compartilham um único modelo residente — nada mais evicta nada.
# Depende do bloco de datas pré-calculadas em voice.ts: ver nota no shared.env.
OLLAMA_TEXT_MODEL='qwen2.5vl:7b'

# ── Web Push (VAPID — par DEDICADO do MoneyAPP) ────────────────────────────
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT='mailto:admin@astralwavelabel.com'

# Username do bot (sem @) — deep link do vinculo hibrido do Telegram.
TELEGRAM_BOT_USERNAME=awl_money_bot

# Fase 2 — chave dedicada para pedir JWT de usuario ao hub (mesmo valor do LoginHub).
HUB_DELEGATION_KEY=

# Fase 3 — fecha a delegacao cega (x-user-id). O bot ja usa JWT delegado.
ALLOW_LEGACY_BOT_DELEGATION=false

# ==========================================
# VERSÃO DO BUILD (gerado por scripts/bump-version.mjs — não editar à mão)
# ==========================================
APP_VERSION=0.0.0
APP_BUILD_DATE=
