#!/usr/bin/expect
set timeout 10
spawn pnpm --filter @moneyapp/db db:generate

expect {
  "Is user_settings table created or renamed from another table" {
    send "\033\[B\r"
    exp_continue
  }
  "created or renamed from another column" {
    send "\r"
    exp_continue
  }
  eof {
    exit 0
  }
}
