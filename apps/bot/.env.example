# Credenciais do bot do Telegram
TELEGRAM_BOT_TOKEN=seu_token_aqui
ALLOWED_USER_ID=seu_id_do_telegram_aqui
USER_EMAIL=seu_email@cadastrado.no.moneyapp

# Banco oficial do MoneyAPP. Dentro do Docker use o hostname do container
# (awlsrvDB_postgres) na rede awl_network. Para rodar no host, aponte para
# localhost na porta publicada (ex.: 9432).
# Importante: deixe a DSN entre aspas simples — a senha contém caracteres especiais.
DATABASE_URL='postgres://user:password@awlsrvDB_postgres:5432/moneyapp'
